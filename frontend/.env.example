# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (example)
# Copy this file to ".env" in the frontend/ folder.
#
# EXPO_PUBLIC_* variables are baked into the app bundle and are visible
# in the client - never put secrets here, only the API base URL.
# ==========================================

# --- LOCAL DEVELOPMENT (testing with Expo Go on your physical phone) ---
# Do NOT use "localhost" here - from your phone, "localhost" means the PHONE
# itself, not your computer. Use your computer's LOCAL NETWORK IP instead.
# Find it with:
#   Windows:      ipconfig            (look for IPv4 Address)
#   Mac/Linux:    ifconfig | grep inet   (or "ip addr")
# Your phone and computer must be on the SAME Wi-Fi network.
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api

# --- PRODUCTION (after deploying backend to Render) ---
# Comment out the line above and uncomment this one, using your real Render URL:
# EXPO_PUBLIC_API_URL=https://your-backend.onrender.com/api
