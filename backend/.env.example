# ==========================================
# BACKEND ENVIRONMENT VARIABLES (example)
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file.
# ==========================================

# Port the Express server listens on locally.
# Render sets its own PORT automatically in production - process.env.PORT is used.
PORT=5000

# MongoDB Atlas connection string
# Get this from Atlas -> Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/attendance-app?retryWrites=true&w=majority

# Secret used to sign JWT tokens. Use a long random string in production.
JWT_SECRET=replace_this_with_a_long_random_secret_string

# How long a login token stays valid
JWT_EXPIRES_IN=7d

# Predefined single Admin account (NOT stored in MongoDB)
ADMIN_ID=admin
ADMIN_PASSWORD=change_this_password

# Comma-separated list of allowed origins for CORS.
# Expo Go / Expo web dev tools use varying origins, so during development "*" is simplest.
# For stricter production setups, list exact origins instead.
CORS_ORIGIN=*
